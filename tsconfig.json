{
  "compilerOptions": {
    "target": "ES2020", // 编译目标版本
    "module": "NodeNext", // 模块系统
    "moduleResolution": "NodeNext", // 模块解析策略
    "declaration": true, // 生成 .d.ts 类型文件（关键，让使用者有类型提示）
    "declarationMap": true, // 生成类型映射文件
    "sourceMap": true, // 生成 sourcemap
    "outDir": "./dist", // 输出目录
    "rootDir": "./", // 源码目录
    "strict": true, // 开启严格模式
    "esModuleInterop": true, // 兼容 CommonJS/ES 模块
    "skipLibCheck": true, // 跳过第三方库类型检查
    "forceConsistentCasingInFileNames": true // 强制文件名大小写一致
  },
  "include": ["src/**/*", "index.ts"], // 要编译的文件
  "exclude": ["node_modules", "dist", "**/*.test.ts"] // 排除文件
}
